# Local development configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in real values there. `.env` is git-ignored; this file is not.
# NEVER put a real key, token, or cluster URL in this file.

# --- Gemini (Google AI Studio) ---
# This project uses an AI Studio API key. It does NOT use Vertex AI,
# a Google Cloud project, gcloud auth, or service accounts.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Gemini model used by the agent. Must be available to your AI Studio key.
GEMINI_MODEL=gemini-3.8-flash

# --- Weaviate Cloud (lab knowledge base) ---
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=your-weaviate-api-key
# Leave empty to auto-discover when the cluster has exactly one collection.
WEAVIATE_COLLECTION=
# Retrieval tuning (optional; defaults shown).
WEAVIATE_SEARCH_LIMIT=4
WEAVIATE_MIN_SCORE=0.5
WEAVIATE_TIMEOUT_SECONDS=15

# --- GREEN API (WhatsApp) ---
GREEN_API_API_URL=https://0000.api.greenapi.com
GREEN_API_ID_INSTANCE=your-instance-id
GREEN_API_TOKEN_INSTANCE=your-instance-token
# MASTER SAFETY SWITCH. While false, no WhatsApp message is ever sent:
# outbound messages are logged as redacted dry-runs only.
GREEN_API_LIVE_ENABLED=false
# Ignore group chats (recommended).
GREEN_API_IGNORE_GROUPS=true
GREEN_API_TIMEOUT_SECONDS=20
# Drop inbound messages older than this many seconds. GREEN API queues
# notifications it could not deliver and replays the whole backlog once the
# webhook URL works again; without this, an outage ends in a burst of replies
# to questions asked hours ago. 0 disables the check.
GREEN_API_MAX_MESSAGE_AGE_SECONDS=600
# DEVELOPMENT GUARD, OFF BY DEFAULT. While empty, every private chat is
# served. Listing numbers restricts the agent to those chats only — handy
# while testing so a stranger who finds the number cannot drive the bot.
# Any spelling works; only the digits are compared:
#   GREEN_API_ALLOWED_CHATS=963991234567,+963 99 765 4321
# This is NOT a security control and NOT identity verification: it limits
# who can talk to the bot, never who a patient is.
GREEN_API_ALLOWED_CHATS=
# Shared secret for POST /webhooks/green-api. Must match the GREEN API console
# field "webhookUrlToken"; the provider sends it as `Authorization: Bearer ...`.
# Without it the endpoint is unauthenticated — anyone who finds the URL can make
# the bot send WhatsApp messages. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GREEN_API_WEBHOOK_TOKEN=

# --- Khatib patient/results backend ---
# Tenant (machine-to-machine) credentials for the laboratory's own API. These
# authenticate THIS DEPLOYMENT, not a customer: they are never requested over
# WhatsApp, never shown to the model, and never logged. Ask the backend owner
# to issue them; do not reuse a token pasted into a chat or a ticket.
# Required for patient verification and results. No default: leave empty to
# run without the patient features (the agent still answers general questions).
KHATIB_API_BASE_URL=
KHATIB_CLIENT_ID=your-khatib-client-id
KHATIB_CLIENT_SECRET=your-khatib-client-secret

# Optional tuning (defaults shown). Leave these alone unless you have a reason.
# Whole-request and connect budgets for every backend call.
KHATIB_API_TIMEOUT_SECONDS=15
KHATIB_API_CONNECT_TIMEOUT_SECONDS=5
# Renew the tenant token this many seconds before it expires.
KHATIB_AUTH_REFRESH_MARGIN_SECONDS=60
# Minimum gap between tenant logins after one fails, so an outage cannot turn
# into a login storm.
KHATIB_AUTH_RETRY_COOLDOWN_SECONDS=30
# Used only if a verify response omits expiresInSeconds.
KHATIB_VERIFICATION_DEFAULT_TTL_SECONDS=300
# Failed identity checks allowed per chat inside the window, before the
# conversation is handed to a human instead.
KHATIB_MAX_VERIFICATION_ATTEMPTS=5
KHATIB_VERIFICATION_ATTEMPT_WINDOW_SECONDS=900

# --- Report images ---
# The backend field holding the report image URL. Spelled by the backend, with
# a capitalised "URL". Change only if the backend changes it.
KHATIB_RESULT_IMAGE_FIELD=imageURL
# Dispositions whose report image may be sent to the patient. Adding one is a
# clinical decision, not a configuration tweak: FINAL + an entry here is what
# releases a medical report to a customer. A URL alone authorises nothing —
# release also needs an unexpired patient verification, an approved host and a
# recognised file extension.
KHATIB_IMAGE_RELEASE_DISPOSITIONS=BENIGN
# Hosts a report image may be fetched from by GREEN API. Leave EMPTY to allow
# only the KHATIB_API_BASE_URL host. Set it when reports move to separate
# storage. Listing hosts replaces the default rather than adding to it.
KHATIB_IMAGE_ALLOWED_HOSTS=

# --- Local backend smoke test (scripts/check_khatib_backend.py) ---
# OPTIONAL. A single designated seed/test identity, used to prove the three
# calls work end to end. Leave empty in any environment holding real patients;
# the script refuses to run without an explicit identity and never enumerates.
KHATIB_SMOKE_FULL_NAME=
KHATIB_SMOKE_DATE_OF_BIRTH=
KHATIB_SMOKE_PHONE_LAST4=

# --- Logging ---
LOG_LEVEL=INFO
